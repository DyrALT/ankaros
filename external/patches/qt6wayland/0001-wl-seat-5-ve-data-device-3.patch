+void DataOffer::data_offer_finish(Resource *resource)
+{
+    // Panonun (selection) tekliflerinde finish olmaz. Kabul edilmiş bir mime tipi ve seçilmiş bir
+    // eylem yoksa, ya da eylem hâlâ "ask" ise istemci erken bitirmiştir (wayland.xml, wl_data_offer.finish)
+    if (!m_dragAndDrop || !m_accepted || m_action == WL_DATA_DEVICE_MANAGER_DND_ACTION_NONE
+        || m_action == WL_DATA_DEVICE_MANAGER_DND_ACTION_ASK) {
+        wl_resource_post_error(resource->handle, WL_DATA_OFFER_ERROR_INVALID_FINISH,
+                               "finish istegi erken geldi");
+        return;
+    }
+    if (m_dataSource)
+        m_dataSource->finished();
+}
+
+void DataOffer::data_offer_set_actions(Resource *resource, uint32_t dnd_actions,
+                                       uint32_t preferred_action)
+{
+    constexpr uint32_t allActions = WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY
+        | WL_DATA_DEVICE_MANAGER_DND_ACTION_MOVE | WL_DATA_DEVICE_MANAGER_DND_ACTION_ASK;
+    if (!m_dragAndDrop) {
+        wl_resource_post_error(resource->handle, WL_DATA_OFFER_ERROR_INVALID_OFFER,
+                               "set_actions yalnizca surukle-birak tekliflerinde kullanilir");
+        return;
+    }
+    if (dnd_actions & ~allActions) {
+        wl_resource_post_error(resource->handle, WL_DATA_OFFER_ERROR_INVALID_ACTION_MASK,
+                               "gecersiz eylem maskesi");
+        return;
+    }
+    // Tercih en çok bir eylem olmalı ve maskede bulunmalı (0 = tercih yok)
+    if (preferred_action && ((preferred_action & (preferred_action - 1))
+                             || !(preferred_action & dnd_actions))) {
+        wl_resource_post_error(resource->handle, WL_DATA_OFFER_ERROR_INVALID_ACTION,
+                               "gecersiz tercih edilen eylem");
+        return;
+    }
+    if (!m_dataSource)
+        return;
+    const uint32_t common = dnd_actions & m_dataSource->actions();
+    // Tercih edilen ortaksa o, değilse ortak olanların ilki (kopyala, taşı, sor)
+    const uint32_t action = (preferred_action & common) ? preferred_action : (common & -common);
+    m_action = action;
+    send_action(action);
+    m_dataSource->sendAction(action);
 }
 
 void DataOffer::data_offer_destroy(Resource *resource)
