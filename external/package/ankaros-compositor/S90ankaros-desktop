#!/bin/sh
#
# ankaros masaüstünü (ankaros-compositor) açılışta başlatır.
# Faz 1'de oturum root olarak açılır, kullanıcı hesabı ve giriş ekranı Faz 2'de.
#

DAEMON="ankaros-compositor"
PIDFILE="/run/$DAEMON.pid"
LOGFILE="/var/log/$DAEMON.log"

start() {
	printf 'Starting %s: ' "$DAEMON"
	# Ortam değişkenleri (eglfs/KMS, dil ayarı, klavye, XDG_RUNTIME_DIR) etkileşimli
	# oturumlarla aynı yerden, /etc/profile.d altından gelir. Ayarlar dosyası için HOME gerekli.
	start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
		--exec /bin/sh -- -c \
		"export HOME=/root USER=root; . /etc/profile; exec /usr/bin/$DAEMON >$LOGFILE 2>&1"
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

stop() {
	printf 'Stopping %s: ' "$DAEMON"
	start-stop-daemon --stop --pidfile "$PIDFILE"
	status=$?
	if [ "$status" -eq 0 ]; then
		rm -f "$PIDFILE"
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

case "$1" in
	start|stop)
		"$1";;
	restart|reload)
		stop
		sleep 1
		start;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
esac
