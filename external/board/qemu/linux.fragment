# Buildroot'un QEMU çekirdek yapılandırmalarına (board/qemu/{aarch64-virt,x86_64}/linux.config) ankaros'un
# eklemeleri. Her iki mimari için de geçerlidir.
# Uyumluluk katmanlarındaki uygulamalar kullanıcının kimliğiyle, root yetkisi olmadan kendi bağlama
# ad alanlarında çalışır (karar 0016, ankaros-katman).
CONFIG_USER_NS=y
# aarch64 yapılandırmasında zaten açık olup x86_64'te olmayanlar: iki imajda da aynı programlar
# çalışsın, zamanlayıcılar aynı hassasiyette olsun.
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_BINFMT_MISC=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
# Ses (karar 0016, docs/ses.md): QEMU'nun virtio-sound-pci aygıtı için SND_VIRTIO, UTM ve gerçek
# bilgisayarlar için Intel HDA ve genel HDA kodeği. Buildroot'un ana yapılandırmalarında ses yok.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_VIRTIO=y
