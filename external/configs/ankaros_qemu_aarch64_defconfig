# Mimari: Apple Silicon üzerinde donanım hızlandırmalı sanal makine için aarch64
BR2_aarch64=y
BR2_cortex_a72=y

# Araç zinciri: Qt 6 için glibc ve C++ desteği
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_CCACHE=y
BR2_GLOBAL_PATCH_DIR="board/qemu/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y

# Sistem
BR2_TARGET_GENERIC_HOSTNAME="ankaros"
BR2_TARGET_GENERIC_ISSUE="ankaros'a hoş geldiniz"
# Kendi init sistemimiz (docs/init.md). Ağ ve getty gibi servisler /etc/ankaros/services altında.
BR2_INIT_ANKAROS=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
# Türkçe dil ayarı (tarih, ay ve gün adları) ve saat dilimi
BR2_GENERATE_LOCALE="tr_TR.UTF-8"
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Europe/Istanbul"
# Kullanıcı hesapları: ankaros (şifre ankaros) ve giriş ekranı kullanıcısı (docs/oturum.md)
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_ANKAROS_PATH)/board/qemu-aarch64/users.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ANKAROS_PATH)/board/qemu-aarch64/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ANKAROS_PATH)/board/qemu-aarch64/post-build.sh"

# Çekirdek: Buildroot'un QEMU aarch64 virt ayarları (virtio-gpu ve virtio-input dahil)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/aarch64-virt/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Grafik yığını: Mesa (sanal GPU için virgl, GPU olmayan ortamlar için softpipe), GBM ve EGL/GLES
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y

# Girdi ve yazı tipleri
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_LIBXKBCOMMON=y
BR2_PACKAGE_XKEYBOARD_CONFIG=y
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_DEJAVU_MONO=y

# Qt 6: eglfs ile doğrudan ekrana çizim, QML, Wayland compositor
BR2_PACKAGE_QT6=y
BR2_PACKAGE_QT6BASE_GUI=y
BR2_PACKAGE_QT6BASE_EGLFS=y
BR2_PACKAGE_QT6BASE_DEFAULT_QPA="eglfs"
BR2_PACKAGE_QT6BASE_OPENGL=y
BR2_PACKAGE_QT6BASE_OPENGL_ES2=y
BR2_PACKAGE_QT6BASE_FONTCONFIG=y
BR2_PACKAGE_QT6BASE_HARFBUZZ=y
BR2_PACKAGE_QT6BASE_PNG=y
BR2_PACKAGE_QT6DECLARATIVE=y
BR2_PACKAGE_QT6DECLARATIVE_QUICK=y
BR2_PACKAGE_QT6SHADERTOOLS=y
BR2_PACKAGE_QT6WAYLAND=y
BR2_PACKAGE_QT6WAYLAND_COMPOSITOR=y

# ankaros
BR2_PACKAGE_ANKAROS_SHELL=y
BR2_PACKAGE_ANKAROS_COMPOSITOR=y

# Kök dosya sistemi (Qt, Mesa ve yazı tipleriyle birlikte büyüdü)
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="768M"
# BR2_TARGET_ROOTFS_TAR is not set
